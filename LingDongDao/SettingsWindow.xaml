<Window x:Class="LingDongDao.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LingDongDao"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="灵动岛设置" Width="900" Height="670" MinWidth="760" MinHeight="550"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#111820" Foreground="#EDF4F7"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE8ED"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DCE8ED"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,8,0,15"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>
        <Style x:Key="HotkeyBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#21313D"/>
            <Setter Property="Foreground" Value="#EDF4F7"/>
            <Setter Property="BorderBrush" Value="#526461"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#21313D"/>
            <Setter Property="Foreground" Value="#EDF4F7"/>
            <Setter Property="BorderBrush" Value="#3A5362"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#EDF4F7"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBody" Background="Transparent" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBody" Property="Background" Value="#31495A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBody" Property="Background" Value="#2B5263"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBody" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
                            <ContentPresenter IsHitTestVisible="False" Margin="11,0,34,0"
                                              VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#B9D0DB" StrokeThickness="1.5"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#1B2A35" BorderBrush="#3A5362" BorderThickness="1"
                                        CornerRadius="6" Padding="4" MinWidth="{Binding ActualWidth, ElementName=ComboBody}">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#19242D"/>
            <Setter Property="BorderBrush" Value="#2B3D48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F7F9"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#8DD7EC"/>
            <Setter Property="Foreground" Value="#172021"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="17,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#273944"/>
            <Setter Property="Foreground" Value="#E0E8E3"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A9BAC4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBody" Background="{TemplateBinding Background}"
                                CornerRadius="7" BorderBrush="#00000000" BorderThickness="2,0,0,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBody" Property="Background" Value="#263746"/>
                                <Setter TargetName="NavBody" Property="BorderBrush" Value="#73D5F2"/>
                                <Setter Property="Foreground" Value="#D8F4FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="178"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#151F28">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="灵动岛  /  设置" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12"
                           Foreground="#D9E8EF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>
                <Button Grid.Column="1" Content="—" Width="44" Height="42" Background="Transparent" Foreground="#C9D9E1"
                        BorderThickness="0" Click="Minimize_Click"/>
                <Button Grid.Column="2" Content="×" Width="44" Height="42" Background="Transparent" Foreground="#C9D9E1"
                        BorderThickness="0" FontSize="20" Click="Close_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Background="#121B23" BorderBrush="#263540" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,18,0,0">
                <TextBlock Text="设置" Margin="24,0,0,18" FontSize="18" FontWeight="SemiBold" Foreground="#F1F7F9"/>
                <Button x:Name="ModeNav" Content="显示模式" Tag="ModePage" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                <Button x:Name="ShapeNav" Content="外观与位置" Tag="ShapePage" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                <Button x:Name="ImageNav" Content="图片工具" Tag="ImagePage" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                <Button x:Name="AlertsNav" Content="提醒与天气" Tag="AlertsPage" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                <Button x:Name="PerceptionNav" Content="桌面感知" Tag="PerceptionPage" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                <Button x:Name="StartupNav" Content="启动与快捷键" Tag="StartupPage" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="25,20,25,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PageTitleText" Grid.Row="0" Text="显示模式" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Margin="0,0,0,14" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#4A6575" CornerRadius="4" Margin="1,0"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>
            <StackPanel Margin="0,0,9,0">
                <StackPanel x:Name="ModePage">
                <Border x:Name="ModePanel" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="显示模式" Style="{StaticResource PanelTitle}"/>
                        <UniformGrid Columns="3" Margin="0,4,0,8">
                            <RadioButton x:Name="AutomaticMode" Content="自动切换" GroupName="DisplayMode"
                                         Checked="DisplayMode_Changed"/>
                            <RadioButton x:Name="ExpandedMode" Content="保持展开" GroupName="DisplayMode"
                                         Checked="DisplayMode_Changed"/>
                            <RadioButton x:Name="HiddenMode" Content="完全隐藏" GroupName="DisplayMode"
                                         Checked="DisplayMode_Changed"/>
                        </UniformGrid>
                        <CheckBox x:Name="HoverExpandCheck" Content="鼠标贴近空闲短线时自动展开"
                                  IsChecked="{Binding HoverExpandEnabled}"
                                  Checked="Appearance_Changed" Unchecked="Appearance_Changed"/>
                    </StackPanel>
                </Border>
                </StackPanel>
                <StackPanel x:Name="ShapePage" Visibility="Collapsed">
                <Border x:Name="ShapePanel" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="位置与尺寸" Style="{StaticResource PanelTitle}"/>
                        <local:SettingSlider x:Name="LineWidthSlider" Label="空闲短线长度" Unit="px"
                                             Minimum="20" Maximum="140" Step="1"
                                             Value="{Binding LineWidth, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="LineThicknessSlider" Label="空闲短线厚度" Unit="px"
                                             Minimum="1" Maximum="10" Step="0.5" Decimals="1"
                                             Value="{Binding LineThickness, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="IslandWidthSlider" Label="展开宽度" Unit="px"
                                             Minimum="220" Maximum="420" Step="1"
                                             Value="{Binding IslandWidth, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="IslandHeightSlider" Label="展开高度" Unit="px"
                                             Minimum="60" Maximum="110" Step="1"
                                             Value="{Binding IslandHeight, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="TopOffsetSlider" Label="距离屏幕顶边" Unit="px"
                                             Minimum="0" Maximum="20" Step="0.5" Decimals="1"
                                             Value="{Binding TopOffset, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <Border Height="1" Background="#35504D" Margin="0,3,0,14"/>
                        <TextBlock Text="短线感应区" Foreground="#8DD7EC" FontSize="12" Margin="0,0,0,8"/>
                        <local:SettingSlider x:Name="HoverHorizontalSlider" Label="左右扩展" Unit="px"
                                             Minimum="0" Maximum="16" Step="1" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="HoverVerticalSlider" Label="上下扩展" Unit="px"
                                             Minimum="0" Maximum="12" Step="1" ValueChanged="Appearance_Changed"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="轮廓与内容" Style="{StaticResource PanelTitle}"/>
                        <local:SettingSlider x:Name="CornerRadiusSlider" Label="圆角半径" Unit="px"
                                             Minimum="10" Maximum="55" Step="1"
                                             Value="{Binding CornerRadius, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="PaddingSlider" Label="内容左右留白" Unit="px"
                                             Minimum="8" Maximum="24" Step="1"
                                             Value="{Binding HorizontalPadding, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="IconSizeSlider" Label="图标尺寸" Unit="px"
                                             Minimum="28" Maximum="48" Step="1"
                                             Value="{Binding IconSize, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="TitleSizeSlider" Label="标题字号" Unit="px"
                                             Minimum="12" Maximum="18" Step="0.5" Decimals="1"
                                             Value="{Binding TitleFontSize, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="DetailSizeSlider" Label="说明字号" Unit="px"
                                             Minimum="9" Maximum="14" Step="0.5" Decimals="1"
                                             Value="{Binding DetailFontSize, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="OpacitySlider" Label="岛体背景不透明度" Unit="%"
                                             Minimum="70" Maximum="100" Step="1"
                                             Value="{Binding BackgroundOpacityPercent, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="动效与停留" Style="{StaticResource PanelTitle}"/>
                        <local:SettingSlider x:Name="AnimationSlider" Label="展开与收起动画" Unit="ms"
                                             Minimum="120" Maximum="700" Step="10"
                                             Value="{Binding AnimationMilliseconds, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="DurationSlider" Label="提示停留时间" Unit="秒"
                                             Minimum="1.5" Maximum="10" Step="0.5" Decimals="1"
                                             Value="{Binding NoticeSeconds, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="ImagePage" Visibility="Collapsed">
                <Border x:Name="ImagePanel" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="图片操作选择条" Style="{StaticResource PanelTitle}"/>
                        <local:SettingSlider x:Name="FormatVisibleItemsSlider" Label="可视格式数量" Unit="项"
                                             Minimum="3" Maximum="5" Step="2"
                                             Value="{Binding FormatVisibleItems, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="FormatItemWidthSlider" Label="每项文字宽度" Unit="px"
                                             Minimum="32" Maximum="52" Step="1"
                                             Value="{Binding FormatItemWidth, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="FormatSpacingSlider" Label="文字间距" Unit="px"
                                             Minimum="0" Maximum="14" Step="1"
                                             Value="{Binding FormatSpacing, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="FormatFontSizeSlider" Label="普通文字字号" Unit="px"
                                             Minimum="10" Maximum="16" Step="0.5" Decimals="1"
                                             Value="{Binding FormatFontSize, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="FormatSelectedFontSizeSlider" Label="选中文字字号" Unit="px"
                                             Minimum="12" Maximum="20" Step="0.5" Decimals="1"
                                             Value="{Binding FormatSelectedFontSize, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="FormatScrollSlider" Label="横向滚动时长" Unit="ms"
                                             Minimum="100" Maximum="600" Step="10"
                                             Value="{Binding FormatScrollMilliseconds, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="图片缩略图与悬浮预览" Style="{StaticResource PanelTitle}"/>
                        <local:SettingSlider x:Name="ImageCornerRadiusSlider" Label="缩略图圆角半径" Unit="px"
                                             Minimum="0" Maximum="24" Step="1"
                                             Value="{Binding ImageCornerRadius, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                        <local:SettingSlider x:Name="ImagePreviewSizeSlider" Label="悬浮大图最大边长" Unit="px"
                                             Minimum="140" Maximum="420" Step="10"
                                             Value="{Binding ImagePreviewSize, Mode=OneWay}" ValueChanged="Appearance_Changed"/>
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="AlertsPage" Visibility="Collapsed">
                <Border x:Name="AlertsPanel" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="提醒开关" Style="{StaticResource PanelTitle}"/>
                        <UniformGrid Columns="2">
                            <CheckBox Content="接入电源" IsChecked="{Binding ChargingEnabled}"/>
                            <CheckBox Content="低电量" IsChecked="{Binding BatteryLowEnabled}"/>
                            <CheckBox Content="复制内容预览" IsChecked="{Binding ClipboardEnabled}"/>
                            <CheckBox Content="音乐卡片（网易云／酷狗）" IsChecked="{Binding MusicEnabled}"/>
                            <CheckBox Content="图片格式转换（Ctrl+0）" IsChecked="{Binding ImageConversionEnabled}"/>
                            <CheckBox Content="图片风格（Ctrl+1）" IsChecked="{Binding ImageStyleEnabled}"/>
                            <CheckBox Content="图片压缩（Ctrl+2）" IsChecked="{Binding ImageCompressionEnabled}"/>
                            <CheckBox Content="Wi‑Fi 连接" IsChecked="{Binding WifiConnectedEnabled}"/>
                            <CheckBox Content="Wi‑Fi 低速" IsChecked="{Binding WifiSlowEnabled}"/>
                            <CheckBox Content="无法访问网络" IsChecked="{Binding NoInternetEnabled}"/>
                            <CheckBox Content="内存占用过高" IsChecked="{Binding MemoryEnabled}"/>
                            <CheckBox Content="温度过高" IsChecked="{Binding TemperatureEnabled}"/>
                            <CheckBox Content="郫都区未来雷雨" IsChecked="{Binding WeatherEnabled}"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="雷雨天气提醒" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="成都市郫都区" Foreground="#A5B9C4" FontSize="11" Margin="0,0,0,10"/>
                        <TextBlock x:Name="WeatherCurrentText" Text="当前天气：查询中" Foreground="#E9F3F5"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBlock x:Name="WeatherForecastText" Text="雷雨预报：查询中" Foreground="#AFC3CC"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="刷新天气" Width="100" HorizontalAlignment="Left" Margin="0,0,0,12"
                                Style="{StaticResource SecondaryButton}" Click="RefreshWeather_Click"/>
                        <local:SettingSlider x:Name="WeatherHoursSlider" Label="预报查看范围" Unit="小时"
                                             Minimum="6" Maximum="48" Step="1"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="提醒阈值" Style="{StaticResource PanelTitle}"/>
                        <Grid>
                            <TextBlock Text="Wi‑Fi 链路速率低于"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="#8DD7EC"
                                       Text="{Binding Value, ElementName=WifiSlider, StringFormat={}{0:0} Mbps}"/>
                        </Grid>
                        <Slider x:Name="WifiSlider" Minimum="5" Maximum="100" TickFrequency="1"
                                Value="{Binding WifiSlowMbps, Mode=TwoWay}"/>
                        <Grid>
                            <TextBlock Text="内存占用达到"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="#8DD7EC"
                                       Text="{Binding Value, ElementName=MemorySlider, StringFormat={}{0:0}%}"/>
                        </Grid>
                        <Slider x:Name="MemorySlider" Minimum="60" Maximum="98" TickFrequency="1"
                                Value="{Binding MemoryPercent, Mode=TwoWay}"/>
                        <Grid>
                            <TextBlock Text="CPU 温度达到"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="#8DD7EC"
                                       Text="{Binding Value, ElementName=CpuSlider, StringFormat={}{0:0}°C}"/>
                        </Grid>
                        <Slider x:Name="CpuSlider" Minimum="70" Maximum="105" TickFrequency="1"
                                Value="{Binding CpuTemperatureC, Mode=TwoWay}"/>
                        <Grid>
                            <TextBlock Text="GPU 温度达到"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="#8DD7EC"
                                       Text="{Binding Value, ElementName=GpuSlider, StringFormat={}{0:0}°C}"/>
                        </Grid>
                        <Slider x:Name="GpuSlider" Minimum="65" Maximum="105" TickFrequency="1"
                                Value="{Binding GpuTemperatureC, Mode=TwoWay}"/>
                        <Grid>
                            <TextBlock Text="未接电且电量低于"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="#8DD7EC"
                                       Text="{Binding Value, ElementName=BatterySlider, StringFormat={}{0:0}%}"/>
                        </Grid>
                        <Slider x:Name="BatterySlider" Minimum="5" Maximum="40" TickFrequency="1"
                                Value="{Binding BatteryLowPercent, Mode=TwoWay}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="PerceptionPage" Visibility="Collapsed">
                <Border x:Name="PerceptionPanel" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="桌面感知" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="默认关闭。开启后截图仅缓存在内存，本地先判断是否需要分析；云端上传需单独授权。"
                                   Foreground="#9CB0BB" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <CheckBox x:Name="PerceptionEnabledCheck" Content="开启本地感知"/>
                        <CheckBox x:Name="PerceptionPausedCheck" Content="暂停监控"/>
                        <CheckBox x:Name="CloudUploadCheck" Content="允许云端分析与截图上传"
                                  Checked="CloudUpload_Checked"/>
                        <TextBlock Text="DeepSeek V4.1 Flash · 密钥仅加密保存在当前 Windows 用户下"
                                   Foreground="#9CB0BB" FontSize="11" Margin="0,2,0,6"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="DeepSeekKeyBox" Grid.Column="0" Height="29"
                                         Background="#111C25" Foreground="#E8F1ED" BorderBrush="#3A5362"/>
                            <Button Grid.Column="1" Content="保存密钥" Margin="7,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Click="SaveDeepSeekKey_Click"/>
                            <Button Grid.Column="2" Content="移除" Margin="7,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Click="RemoveDeepSeekKey_Click"/>
                        </Grid>
                        <TextBlock x:Name="CloudCredentialStatusText" Foreground="#A5B9C4"
                                   FontSize="11" Margin="0,0,0,5"/>
                        <CheckBox x:Name="GuiDetectorCheck" Content="增强模式使用 GUI 视觉检测器"/>
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="资源模式" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <ComboBox x:Name="ResourceModeChoice" Grid.Column="1" Height="30"
                                      Background="#21313D" Foreground="#EDF4F7">
                                <ComboBoxItem Content="低负载：窗口 API + 变化时 OCR" Tag="Low"/>
                                <ComboBoxItem Content="标准：窗口 API + OCR + 规则" Tag="Standard"/>
                                <ComboBoxItem Content="增强：额外启用 GUI 检测" Tag="Enhanced"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="PerceptionStatusText" Foreground="#DCE8ED"
                                   TextWrapping="Wrap" Margin="0,8,0,5"/>
                        <TextBlock x:Name="PerceptionResourceText" Foreground="#9CB0BB"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <CheckBox x:Name="DebugOverlayCheck" Content="屏幕调试标注：显示 OCR 文字、GUI 控件和坐标"
                                  Margin="0,2,0,5"/>
                        <TextBlock Text="本地绘制；关闭感知或切换敏感窗口时隐藏。GUI 视觉检测需要增强模式。"
                                   Foreground="#92A9B6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <local:SettingSlider x:Name="PerceptionSampleSlider" Label="截图间隔" Unit="秒"
                                             Minimum="0.5" Maximum="10" Step="0.5" Decimals="1"/>
                        <local:SettingSlider x:Name="PerceptionThresholdSlider" Label="云端触发阈值" Unit=""
                                             Minimum="0.5" Maximum="1" Step="0.05" Decimals="2"/>
                        <TextBlock Text="在目标窗口按“主动分析”快捷键可立即调用云端；快捷键在下方修改。手动分析会显示结果，即使 AI 判断无需提醒。"
                                   Foreground="#9CB0BB" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="查看云端调用记录与截图" Width="190" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}" Click="OpenCloudHistory_Click" Margin="0,0,0,8"/>
                        <TextBlock Text="全桌面 Agent" Foreground="#8DD7EC" FontSize="12" Margin="0,12,0,7"/>
                        <TextBlock Text="按 Ctrl+Alt+K 召唤，输入任务后按 Enter。它会查看所有显示器，跨软件打开或切换窗口，用蓝色光标点击，也能输入文字、滚动和拖动；每步后截图确认。快捷键可在“启动与快捷键”修改。"
                                   Foreground="#9CB0BB" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <local:SettingSlider x:Name="QuickAgentMaxActionsSlider" Label="全桌面 Agent 最多操作步数" Unit="步"
                                             Minimum="1" Maximum="20" Step="1" Decimals="0"/>
                        <TextBlock Text="蓝色光标" Foreground="#8DD7EC" FontSize="12" Margin="0,14,0,7"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="光标颜色" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <TextBox x:Name="AgentCursorColorBox" Grid.Column="1" Height="30" MaxLength="7"
                                     Background="#111C25" Foreground="#E8F1ED" BorderBrush="#3A5362"
                                     Padding="8,4" ToolTip="输入 #RRGGBB，例如 #3BB8FF"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="光标形状" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <ComboBox x:Name="AgentCursorShapeChoice" Grid.Column="1" Height="30"
                                      Background="#21313D" Foreground="#EDF4F7">
                                <ComboBoxItem Content="经典箭头" Tag="arrow"/>
                                <ComboBoxItem Content="细箭头" Tag="slim"/>
                                <ComboBoxItem Content="菱角箭头" Tag="diamond"/>
                            </ComboBox>
                        </Grid>
                        <local:SettingSlider x:Name="AgentCursorSizeSlider" Label="光标大小" Unit="px"
                                              Minimum="20" Maximum="80" Step="1" Decimals="0"/>
                        <local:SettingSlider x:Name="AgentGlowSlider" Label="发光半径" Unit="px"
                                              Minimum="0" Maximum="50" Step="1" Decimals="0"/>
                        <local:SettingSlider x:Name="AgentGlowOpacitySlider" Label="发光强度" Unit=""
                                              Minimum="0" Maximum="1" Step="0.05" Decimals="2"/>
                        <local:SettingSlider x:Name="AgentMoveSlider" Label="移动时长" Unit="ms"
                                              Minimum="120" Maximum="1600" Step="20" Decimals="0"/>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="移动曲线" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <ComboBox x:Name="AgentCursorCurveChoice" Grid.Column="1" Height="30"
                                      Background="#21313D" Foreground="#EDF4F7">
                                <ComboBoxItem Content="平滑起止" Tag="smooth"/>
                                <ComboBoxItem Content="匀速直线" Tag="linear"/>
                                <ComboBoxItem Content="快速起步" Tag="easeOut"/>
                                <ComboBoxItem Content="模拟弧线" Tag="human"/>
                            </ComboBox>
                        </Grid>
                        <local:SettingSlider x:Name="AgentActionPauseSlider" Label="操作间隔" Unit="ms"
                                              Minimum="0" Maximum="1500" Step="50" Decimals="0"/>
                        <local:SettingSlider x:Name="AgentTypingSlider" Label="每字输入间隔" Unit="ms"
                                              Minimum="0" Maximum="250" Step="5" Decimals="0"/>
                        <local:SettingSlider x:Name="AgentSparkSlider" Label="点击火花数量" Unit="粒"
                                              Minimum="0" Maximum="16" Step="1" Decimals="0"/>
                        <TextBlock Text="任务经验与定时唤醒" Foreground="#8DD7EC" FontSize="12" Margin="0,14,0,7"/>
                        <TextBlock x:Name="AgentSkillStatusText" Foreground="#9CB0BB" TextWrapping="Wrap" Margin="0,0,0,7"/>
                        <TextBlock Text="最近成功经验" Foreground="#DCE8ED" Margin="0,4,0,5"/>
                        <ListBox x:Name="AgentSkillList" Height="85" Background="#111C25" Foreground="#B6D5DE"
                                 BorderBrush="#3A5362" FontSize="11"/>
                        <TextBlock Text="待唤醒任务" Foreground="#DCE8ED" Margin="0,10,0,5"/>
                        <ListBox x:Name="AgentWakeList" Height="70" Background="#111C25" Foreground="#B6D5DE"
                                 BorderBrush="#3A5362" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="清空成功经验" Width="120" Style="{StaticResource SecondaryButton}"
                                    Click="ClearAgentSkills_Click" Margin="0,0,8,0"/>
                            <Button Content="取消所有定时唤醒" Width="145" Style="{StaticResource SecondaryButton}"
                                    Click="ClearAgentWakes_Click"/>
                        </StackPanel>
                        <TextBlock Text="固定窗口 Agent" Foreground="#8DD7EC" FontSize="12" Margin="0,4,0,7"/>
                        <TextBlock Text="下方旧模式只操作启动时的目标软件。写明任务目标并保存，切换到目标软件后按“启动 Agent”快捷键；可随时按“停止 Agent”快捷键。"
                                   Foreground="#9CB0BB" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                        <TextBox x:Name="AgentGoalBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="#111C25" Foreground="#E8F1ED"
                                 BorderBrush="#3A5362" Padding="8"/>
                        <local:SettingSlider x:Name="AgentMaxActionsSlider" Label="固定窗口 Agent 最多操作步数" Unit="步"
                                             Minimum="1" Maximum="20" Step="1" Decimals="0"/>
                        <local:SettingSlider x:Name="CloudDailyBudgetSlider" Label="每日云端预估预算" Unit="美元"
                                             Minimum="0.05" Maximum="5" Step="0.05" Decimals="2"/>
                        <TextBlock x:Name="AgentStatusText" Foreground="#9BD6C6" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <Button Content="停止当前 Agent" Width="125" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}" Click="StopAgent_Click" Margin="0,0,0,10"/>
                        <Button Content="清空内存截图" Width="125" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}" Click="ClearFrames_Click"/>
                        <TextBlock Text="感知日志" Foreground="#8DD7EC" FontSize="12" Margin="0,14,0,7"/>
                        <TextBox x:Name="PerceptionLogBox" Height="180" IsReadOnly="True"
                                 Background="#070D0F" Foreground="#9BD6C6" BorderBrush="#344547"
                                 FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="StartupPage" Visibility="Collapsed">
                <Border x:Name="StartupPanel" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="启动与快捷键" Style="{StaticResource PanelTitle}"/>
                        <CheckBox x:Name="StartupCheck" Content="开机自动启动灵动岛" IsChecked="{Binding StartWithWindows}"/>
                        <TextBlock Text="点击右侧按键框，然后按下新的组合键" Foreground="#9CB0BB" FontSize="11" Margin="0,8,0,9"/>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="控制面板" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <TextBox x:Name="PanelHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBoxStyle}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="图片格式" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <TextBox x:Name="FormatHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBoxStyle}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="图片风格" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <TextBox x:Name="StyleHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBoxStyle}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="图片压缩" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <TextBox x:Name="CompressHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBoxStyle}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="主动分析" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <TextBox x:Name="ManualAnalysisHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBoxStyle}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="启动 Agent" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <TextBox x:Name="AgentStartHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBoxStyle}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="召唤 Agent" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <TextBox x:Name="AgentCommandHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBoxStyle}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="停止 Agent" VerticalAlignment="Center" Foreground="#DCE8ED"/>
                            <TextBox x:Name="AgentStopHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBoxStyle}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <Button Content="恢复默认" Width="100" HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButton}" Click="Reset_Click"/>
                <TextBlock x:Name="ErrorText" Foreground="#FFAC8F" FontSize="11" Margin="0,6,0,0"
                           TextWrapping="Wrap" MaxWidth="330"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,9,0"
                        Click="Cancel_Click"/>
                <Button Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>
