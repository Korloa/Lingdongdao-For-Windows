<Window x:Class="LingDongDao.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛" Width="360" Height="116"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" Focusable="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Border x:Name="Island"
                Width="58" Height="4"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,1,0,0"
                CornerRadius="24" BorderThickness="1"
                MouseLeftButtonUp="Island_MouseLeftButtonUp">
            <Border.Background>
                <SolidColorBrush x:Name="IslandBrush" Color="#A8AFBB"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush x:Name="OutlineBrush" Color="#00FFFFFF"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect x:Name="IslandShadow" BlurRadius="22" ShadowDepth="4" Opacity="0" Color="#000000"/>
            </Border.Effect>
            <Grid ClipToBounds="True">
                <Grid x:Name="ExpandedContent" Opacity="0" Visibility="Collapsed" Margin="21,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="IconColumn" Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBadge" Width="44" Height="44" CornerRadius="22"
                            Background="#1939DDA1" VerticalAlignment="Center">
                        <Path x:Name="NoticeIcon" Data="M 13,2 L 5,13 L 11,13 L 9,22 L 20,9 L 14,9 Z"
                              Fill="#54F4B0" Stretch="Uniform" Width="23" Height="23"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse x:Name="PreviewCircle" Width="44" Height="44" VerticalAlignment="Center"
                             Visibility="Collapsed"/>
                    <StackPanel x:Name="ContentText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="TitleText" Text="正在充电" FontFamily="Microsoft YaHei UI"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#F7F8FA"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DetailText" Text="已连接电源" FontFamily="Microsoft YaHei UI"
                                   FontSize="11" Foreground="#A8AFBB" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid x:Name="FormatPicker" Grid.Column="1" Margin="8,0,0,0"
                          VerticalAlignment="Center" Visibility="Collapsed" Focusable="True"
                          Background="Transparent"
                          PreviewMouseWheel="Picker_PreviewMouseWheel">
                        <Grid.Resources>
                            <Style x:Key="FormatTextButton" TargetType="Button">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontFamily="{TemplateBinding FontFamily}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           FontWeight="{TemplateBinding FontWeight}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <StackPanel>
                            <TextBlock x:Name="PickerHint" Text="选择格式 · A/D 或滚轮" FontFamily="Microsoft YaHei UI"
                                       FontSize="10" Foreground="#A8AFBB" Margin="2,0,0,4"/>
                            <UniformGrid x:Name="FormatRow" Columns="3" Background="Transparent">
                                <UniformGrid.RenderTransform><TranslateTransform x:Name="FormatShift"/></UniformGrid.RenderTransform>
                                <Button x:Name="PreviousFormat" Height="27" Margin="1,0"
                                        Style="{StaticResource FormatTextButton}" FontFamily="Microsoft YaHei UI"
                                        Foreground="#A8AFBB" FontSize="12" Click="FormatButton_Click"/>
                                <Button x:Name="CurrentFormat" Height="27" Margin="1,0"
                                        Style="{StaticResource FormatTextButton}" FontFamily="Microsoft YaHei UI"
                                        Foreground="#55E9AB" FontSize="14" FontWeight="SemiBold"
                                        RenderTransformOrigin="0.5,0.5" Click="FormatButton_Click">
                                    <Button.RenderTransform><ScaleTransform x:Name="CurrentFormatScale"/></Button.RenderTransform>
                                </Button>
                                <Button x:Name="NextFormat" Height="27" Margin="1,0"
                                        Style="{StaticResource FormatTextButton}" FontFamily="Microsoft YaHei UI"
                                        Foreground="#A8AFBB" FontSize="12" Click="FormatButton_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="BatteryIndicator" Grid.Column="2" Width="28" Height="16"
                          VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed">
                        <Border Width="24" Height="15" HorizontalAlignment="Left" CornerRadius="3"
                                BorderThickness="1.3" BorderBrush="#A8AFBB"/>
                        <Border Width="2" Height="6" HorizontalAlignment="Right" CornerRadius="1"
                                Background="#A8AFBB"/>
                        <Border x:Name="BatteryFill" Width="12" Height="9" HorizontalAlignment="Left"
                                Margin="3,0,0,0" CornerRadius="1.5" Background="#54F4B0"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
