<Window x:Class="LingDongDao.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛" Width="360" Height="116"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" Focusable="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="MusicControlButton" TargetType="Button">
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F7F8FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FF91A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="Island"
                Width="58" Height="4"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,1,0,0"
                CornerRadius="24" BorderThickness="1"
                MouseEnter="IdleHoverTarget_MouseEnter"
                MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_MouseLeftButtonUp">
            <Border.Background>
                <SolidColorBrush x:Name="IslandBrush" Color="#A8AFBB"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush x:Name="OutlineBrush" Color="#00FFFFFF"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect x:Name="IslandShadow" BlurRadius="22" ShadowDepth="4" Opacity="0" Color="#000000"/>
            </Border.Effect>
            <Grid ClipToBounds="True">
                <Grid x:Name="ExpandedContent" Opacity="0" Visibility="Collapsed" Margin="21,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="IconColumn" Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBadge" Width="44" Height="44" CornerRadius="22"
                            Background="#1939DDA1" VerticalAlignment="Center">
                        <Path x:Name="NoticeIcon" Data="M 13,2 L 5,13 L 11,13 L 9,22 L 20,9 L 14,9 Z"
                              Fill="#54F4B0" Stretch="Uniform" Width="23" Height="23"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="PreviewImageFrame" Width="44" Height="44"
                            VerticalAlignment="Center" Visibility="Collapsed" Focusable="False" Cursor="Hand"
                            AutomationProperties.Name="图片缩略图"
                            MouseEnter="PreviewImageFrame_MouseEnter"
                            MouseLeave="PreviewImageFrame_MouseLeave" Click="PreviewImageFrame_Click">
                        <Button.Background>
                            <ImageBrush x:Name="PreviewImageBrush" Stretch="UniformToFill"/>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel x:Name="ContentText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="TitleText" Text="正在充电" FontFamily="Microsoft YaHei UI"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#F7F8FA"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DetailText" Text="已连接电源" FontFamily="Microsoft YaHei UI"
                                   FontSize="11" Foreground="#A8AFBB" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border x:Name="MusicProgressTrack" Height="4" Margin="0,6,0,0"
                                Background="#39434B" ClipToBounds="True" Visibility="Collapsed"
                                SizeChanged="MusicProgressTrack_SizeChanged"
                                PreviewMouseLeftButtonDown="MusicProgressTrack_MouseLeftButtonDown">
                            <Border x:Name="MusicProgressFill" HorizontalAlignment="Left" Width="0"
                                    Background="#FF7794"/>
                        </Border>
                    </StackPanel>
                    <Grid x:Name="FormatPicker" Grid.Column="1" Margin="8,0,0,0"
                          VerticalAlignment="Center" Visibility="Collapsed" Focusable="True"
                          Background="Transparent" ClipToBounds="True"
                          PreviewMouseWheel="Picker_PreviewMouseWheel">
                        <Grid.Resources>
                            <Style x:Key="FormatTextButton" TargetType="Button">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontFamily="{TemplateBinding FontFamily}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           FontWeight="{TemplateBinding FontWeight}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <StackPanel>
                            <TextBlock x:Name="PickerHint" Text="选择格式 · A/D 或滚轮" FontFamily="Microsoft YaHei UI"
                                       FontSize="10" Foreground="#A8AFBB" Margin="2,0,0,4"/>
                            <Grid x:Name="FormatViewport" Width="200" Height="27"
                                  HorizontalAlignment="Center" Background="Transparent"
                                  ClipToBounds="True" SizeChanged="FormatViewport_SizeChanged">
                                <Canvas x:Name="FormatTrack" Width="280" Height="27" HorizontalAlignment="Left">
                                    <Canvas.RenderTransform><TranslateTransform x:Name="FormatShift"/></Canvas.RenderTransform>
                                </Canvas>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="BatteryIndicator" Grid.Column="2" Width="28" Height="16"
                          VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed">
                        <Border Width="24" Height="15" HorizontalAlignment="Left" CornerRadius="3"
                                BorderThickness="1.3" BorderBrush="#A8AFBB"/>
                        <Border Width="2" Height="6" HorizontalAlignment="Right" CornerRadius="1"
                                Background="#A8AFBB"/>
                        <Border x:Name="BatteryFill" Width="12" Height="9" HorizontalAlignment="Left"
                                Margin="3,0,0,0" CornerRadius="1.5" Background="#54F4B0"/>
                    </Grid>
                    <StackPanel x:Name="MusicControls" Grid.Column="2" Orientation="Vertical"
                                VerticalAlignment="Center" Margin="5,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="MusicTimeText" Text="0:00 / 0:00" FontFamily="Microsoft YaHei UI"
                                   FontSize="9" Foreground="#A8AFBB" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⏮" Style="{StaticResource MusicControlButton}"
                                    AutomationProperties.Name="上一首" Click="MusicPrevious_Click"/>
                            <Button x:Name="MusicToggleButton" Content="Ⅱ" Style="{StaticResource MusicControlButton}"
                                    AutomationProperties.Name="暂停" Click="MusicToggle_Click"/>
                            <Button Content="⏭" Style="{StaticResource MusicControlButton}"
                                    AutomationProperties.Name="下一首" Click="MusicNext_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Button x:Name="IdleHoverTarget" Width="76" Height="18"
                HorizontalAlignment="Center" VerticalAlignment="Top" Background="#01000000"
                Focusable="False" AutomationProperties.Name="空闲短线感应区"
                MouseEnter="IdleHoverTarget_MouseEnter" Click="IdleHoverTarget_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Popup x:Name="ImageHoverPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=Island}"
               VerticalOffset="8" AllowsTransparency="True" StaysOpen="True" Focusable="True">
            <Border x:Name="ImageHoverPanel" Padding="9" CornerRadius="14"
                    Background="#F1090B11" BorderBrush="#667D8DA5" BorderThickness="1"
                    AutomationProperties.Name="图片悬浮预览"
                    MouseEnter="ImageHoverPanel_MouseEnter" MouseLeave="ImageHoverPanel_MouseLeave"
                    PreviewMouseWheel="ImageHoverPanel_PreviewMouseWheel">
                <Border.Resources>
                    <Style x:Key="EditChip" TargetType="Button">
                        <Setter Property="Background" Value="#273336"/>
                        <Setter Property="Foreground" Value="#EAF1ED"/>
                        <Setter Property="BorderBrush" Value="#4B6260"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="9,5"/>
                        <Setter Property="Margin" Value="3"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#405855"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>
                <StackPanel>
                    <Grid>
                        <ScrollViewer x:Name="ImageHoverScroll" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" Background="#11171A">
                            <Grid x:Name="ImageStage" Width="260" Height="260">
                                <Image x:Name="ImageHoverFull" Stretch="Fill" Width="260" Height="260"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <InkCanvas x:Name="ImageEditInk" Background="#01000000"
                                           Visibility="Collapsed"/>
                                <Canvas x:Name="ImageCropOverlay" Background="#01000000" Visibility="Collapsed"
                                        MouseLeftButtonDown="ImageCrop_MouseDown"
                                        MouseMove="ImageCrop_MouseMove"
                                        MouseLeftButtonUp="ImageCrop_MouseUp">
                                    <Rectangle x:Name="ImageCropSelection" Visibility="Collapsed"
                                               Stroke="#F4C58A" StrokeThickness="2" Fill="#44F4C58A"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                        <Button x:Name="ImageEditButton" Content="✎" ToolTip="编辑图片"
                                Width="32" Height="32" FontSize="18" FontWeight="Bold"
                                Style="{StaticResource EditChip}" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom" Margin="0,0,7,7"
                                Click="ImageEditButton_Click"/>
                    </Grid>
                    <StackPanel x:Name="ImageEditorBar" Visibility="Collapsed" MinWidth="380"
                                HorizontalAlignment="Center" Margin="0,9,0,0">
                        <WrapPanel HorizontalAlignment="Center">
                            <Button x:Name="ImageDrawButton" Content="画笔" Style="{StaticResource EditChip}"
                                    Click="ImageDraw_Click"/>
                            <Button x:Name="ImageCropButton" Content="截图/裁剪" Style="{StaticResource EditChip}"
                                    Click="ImageCrop_Click"/>
                            <Button x:Name="ImageCompressButton" Content="压缩" Style="{StaticResource EditChip}" Click="ImageCompress_Click"/>
                            <Button x:Name="ImageStyleButton" Content="风格" Style="{StaticResource EditChip}" Click="ImageStyle_Click"/>
                            <Button Content="↶ 撤回" Style="{StaticResource EditChip}" Click="ImageUndo_Click"/>
                            <Button Content="取消" Style="{StaticResource EditChip}" Click="ImageCancel_Click"/>
                            <Button Content="✓ 完成" Background="#F4C58A" Foreground="#172021"
                                    Style="{StaticResource EditChip}" Click="ImageConfirm_Click"/>
                        </WrapPanel>
                        <StackPanel x:Name="ImageEditOptions" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="Collapsed" Margin="0,5,0,0">
                            <ComboBox x:Name="ImageStyleChoice" Width="115" Height="28" Visibility="Collapsed"/>
                            <ComboBox x:Name="ImageSizeChoice" Width="145" Height="28" Visibility="Collapsed"/>
                            <Button Content="应用" Style="{StaticResource EditChip}" Click="ImageApplyOption_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ImageEditStatus" Text="滚轮缩放 · 选择工具开始编辑"
                                   TextAlignment="Center" Foreground="#A9BCB7" FontSize="11"
                                   Margin="0,7,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
